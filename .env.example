# Map tiles. Optional: with none of these set, the map uses CARTO's dark basemap,
# which needs no key. Set them in the Vercel project (Settings -> Environment
# Variables) to serve a different provider, then redeploy.
#
# VITE_MAP_TILES_URL=https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors, SRTM | &copy; OpenTopoMap (CC-BY-SA)
# VITE_MAP_MAX_ZOOM=17
#
# Or, with a MapTiler account, just the key:
# VITE_MAPTILER_KEY=your-key-here

# Live buyback quotes. The desks publish no APIs and block scraping, so this points at
# one aggregator or proxy you have an account with (BookScouter is the realistic one).
# These are SERVER variables: the key never reaches the browser, which calls
# /api/quotes on this deployment and nothing else.
#
# QUOTE_API_URL=https://api.bookscouter.com/v2/offers
# QUOTE_API_KEY=your-key-here
#
# Browser-side override, only if the endpoint is public and CORS-open (no secret):
# VITE_QUOTE_API_URL=https://your-proxy.example/api/quotes

# Spine detection runs locally from an ONNX model (no key, no cloud). Install one with:
#   node scripts/fetch-model.mjs ./best.onnx        # or SPINE_MODEL_URL=https://... npm run fetch:model
# With no model the app uses its own edge-detection segmenter.
#
# SPINE_MODEL_URL=https://example.com/spines.onnx
